APP_NAME=WerkstattAI Intake API
LOG_LEVEL=INFO
# Railway übernimmt automatisch RAILWAY_ENVIRONMENT_NAME; lokal development.
APP_ENV=development
# Leer: Browserzugriffe nur vom eigenen Origin. Mehrere HTTPS-Origins mit Komma trennen.
CORS_ALLOWED_ORIGINS=
# Auf Railway automatisch 100.64.0.0/10; lokal ohne Proxy leer lassen.
TRUSTED_PROXY_CIDRS=
RATE_LIMIT_REQUESTS_PER_MINUTE=300
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_WEBHOOK_PER_MINUTE=600
DEFAULT_WORKSHOP_ID=demo-werkstatt
# Eigenständiger öffentlicher Demobereich. Niemals die Produktiv-ID verwenden.
DEMO_WORKSHOP_ID=werkstattai-demo

# Lokal leer lassen = SQLite in ./data/werkstattai.db
# Railway PostgreSQL setzt diese Variable automatisch, wenn eine Postgres-DB verbunden ist.
DATABASE_URL=
# Optionaler lokaler SQLite-Pfad, vor allem für isolierte Testläufe.
WERKSTATTAI_SQLITE_PATH=

# Dashboard login
# Startwerte für neue Konten; bestehende Konten werden beim Neustart nicht überschrieben.
# In Produktion unbedingt auf starke, eigene Werte setzen.
AUTH_SECRET=change-this-to-a-long-random-secret
DASHBOARD_ADMIN_EMAIL=admin@werkstatt.local
DASHBOARD_ADMIN_PASSWORD=change-this-password
DASHBOARD_ADMIN_ROLE=admin
# Lokal: auto setzt Secure bei HTTPS/X-Forwarded-Proto=https, bei HTTP nicht.
# In Produktion sind Sitzungscookies immer Secure; false wird abgewiesen.
SESSION_COOKIE_SECURE=auto
TRIAL_DAYS=14

# WhatsApp Cloud API webhook
WHATSAPP_VERIFY_TOKEN=change-this-whatsapp-webhook-token
WHATSAPP_APP_SECRET=
WHATSAPP_DEFAULT_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v23.0
# Optional: freigegebene Vorlage zum Start einer Unterhaltung außerhalb des 24-h-Fensters.
# Name und Sprache müssen exakt zur in Meta freigegebenen Vorlage passen.
# Für Metas Testnummer kann ausschließlich zum Testen hello_world / en_US verwendet werden.
WHATSAPP_START_TEMPLATE_NAME=
WHATSAPP_START_TEMPLATE_LANGUAGE=
# Optional: oeffentliche Callback-URL, z.B. Cloudflare Worker URL.
# Wenn leer, zeigt das Dashboard /webhooks/whatsapp auf der aktuellen App-Domain.
WHATSAPP_WEBHOOK_PUBLIC_URL=

# Optional fuer spaeter
OPENAI_API_KEY=
