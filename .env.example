APP_NAME=WerkstattAI Intake API
LOG_LEVEL=INFO
DEFAULT_WORKSHOP_ID=demo-werkstatt

# Lokal leer lassen = SQLite in ./data/werkstattai.db
# Railway PostgreSQL setzt diese Variable automatisch, wenn eine Postgres-DB verbunden ist.
DATABASE_URL=
# Optionaler lokaler SQLite-Pfad, vor allem für isolierte Testläufe.
WERKSTATTAI_SQLITE_PATH=

# Dashboard login
# In Produktion unbedingt auf starke, eigene Werte setzen.
AUTH_SECRET=change-this-to-a-long-random-secret
DASHBOARD_ADMIN_EMAIL=admin@werkstatt.local
DASHBOARD_ADMIN_PASSWORD=change-this-password
DASHBOARD_ADMIN_ROLE=admin
# auto = secure bei HTTPS/X-Forwarded-Proto=https, lokal bei HTTP nicht.
# In Produktion kann SESSION_COOKIE_SECURE=true erzwungen werden.
SESSION_COOKIE_SECURE=auto
TRIAL_DAYS=14

# WhatsApp Cloud API webhook
WHATSAPP_VERIFY_TOKEN=change-this-whatsapp-webhook-token
WHATSAPP_APP_SECRET=
WHATSAPP_DEFAULT_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v23.0
# Optional: oeffentliche Callback-URL, z.B. Cloudflare Worker URL.
# Wenn leer, zeigt das Dashboard /webhooks/whatsapp auf der aktuellen App-Domain.
WHATSAPP_WEBHOOK_PUBLIC_URL=

# Optional fuer spaeter
OPENAI_API_KEY=
